# Host port published on robin. Open http://robin.local:8083
BERRYTONE_PORT=8083

# Folder on robin. Mounted read-only at /music inside the container.
MUSIC_PATH=/media/pi/PiDrive/Music

# Downloads folder. Mounted read-only at /downloads. Played under Folders, not added to the library.
DOWNLOADS_PATH=/media/pi/PiDrive/YTDL

# Linux user that can read MUSIC_PATH. On Raspberry Pi OS this is usually 1000.
# Find it on robin with: id -u && id -g
PUID=1000
PGID=1000

# Login for the website and Amperfy. Leave both blank only on a private home network.
BERRYTONE_USER=
BERRYTONE_PASSWORD=

# Optional address Sonos uses to fetch music, if the automatic one is wrong.
# BERRYTONE_ADVERTISE=http://192.168.1.20:8083

# How many files to read at once during a library scan.
SCAN_CONCURRENCY=3
